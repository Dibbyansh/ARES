# Copy this file to .env and fill in your real values.
# Never commit the real .env to git — only this example file.

# ── LLM (OpenRouter) ──────────────────────────────────────────────────────────
# Sign up at https://openrouter.ai to get an API key and pick a model.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The model string from OpenRouter, e.g. "openai/gpt-4o" or "mistralai/mistral-7b-instruct"
MODEL=openai/gpt-4o-mini

# ── PostgreSQL database ───────────────────────────────────────────────────────
# Run a local Postgres or use a free cloud one (e.g. Supabase, Neon, Railway).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ares
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ── Telegram notifications ────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get a token.
# Find your chat ID by messaging @userinfobot.
# Leave blank to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

TELEGRAM_CHAT_ID=your_telegram_chat_id_here
